# Browser-safe public configuration
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase configuration
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini, used only by Netlify Functions
GEMINI_API_KEY=
LIVE_AI_ENABLED=true
AI_FREE_USER_MONTHLY_LIMIT=3
AI_GLOBAL_MONTHLY_LIMIT=500

# Stripe, standard one-time Checkout for the annual Sprint Pass
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SPRINT_PASS_PRICE_ID=

# Application and owner controls
APP_URL=http://localhost:5173
ADMIN_EMAILS=
COST_MODE=free
ALLOW_PAID_INFRA=false

# Optional adapters. Leave blank to use no-op/demo-safe behavior.
ANALYTICS_PROVIDER=
ERROR_MONITORING_DSN=
